// Copy to Secrets.xcconfig (gitignored) and fill in. These are only fallbacks:
// the app reads supabase.url and supabase.anonKey from GET /api/v1/config at launch.
// Never put the Supabase service-role key here. The anon key is public by design.
SUPABASE_URL = https:/$()/YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY = YOUR_SUPABASE_ANON_KEY

// Optional: point Debug builds at a LAN machine instead of localhost.
// API_BASE_URL = http:/$()/localhost:3000/api/v1
