<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UNSOLO_API_BASE_URL</key>
	<string>$(API_BASE_URL)</string>
	<key>UNSOLO_WEB_BASE_URL</key>
	<string>$(WEB_BASE_URL)</string>
	<key>UNSOLO_SUPABASE_URL</key>
	<string>$(SUPABASE_URL)</string>
	<key>UNSOLO_SUPABASE_ANON_KEY</key>
	<string>$(SUPABASE_ANON_KEY)</string>
	<key>UNSOLO_DEMO_MODE</key>
	<string>$(UNSOLO_DEMO_MODE)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>UnSOLO uses your approximate location to suggest plans, departures and stays near you. Your location is rounded and never shown to other travellers.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Pick photos for your plans and stories. UnSOLO only sees the photos you choose.</string>
	<key>NSCameraUsageDescription</key>
	<string>Take a photo for your story or plan.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>in.unsolo.app.refresh</string>
		<string>in.unsolo.app.outbox</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>in.unsolo.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>unsolo</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<false/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
