# Copy to secrets.properties (gitignored) and fill in. Values are only fallbacks:
# the app reads supabase.url / supabase.anonKey from GET /api/v1/config at launch.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Google "Web application" OAuth client ID used by Credential Manager (Sign in with Google).
# Empty = the app falls back to Supabase OAuth in a Custom Tab (PKCE, redirect unsolo://auth-callback).
GOOGLE_WEB_CLIENT_ID=
